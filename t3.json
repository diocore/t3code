{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Dev",
      "command": "vp run dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Deploy frontend",
      "command": "vp run deploy:frontend",
      "icon": "build"
    },
    {
      "name": "Deploy backend (restarts server)",
      "command": "vp run deploy:backend",
      "icon": "build"
    },
    {
      "name": "Deploy app (restarts desktop)",
      "command": "vp run deploy:app",
      "icon": "build"
    }
  ]
}
